# promeNOODology — environment variables
#
# HOW TO USE
#   1. Copy this file:  cp .env.example .env.local
#   2. Fill in the values from the Supabase dashboard (where to find each one is
#      written above it).
#   3. Restart `npm run dev` — Next.js only reads this file at startup.
#
# .env.local is git-ignored and must stay that way: it holds a key that can read
# and write everything in the database.
#
# The right-hand column says whether the variable also belongs in Vercel:
#   Project → Settings → Environment Variables (tick Production, Preview and
#   Development for all three of the ones marked "yes").


# ---------------------------------------------------------------- Supabase ---

# The project's address.
# Supabase → Project Settings → Data API → Project URL
# VERCEL: yes
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# The public key. This one is meant to be in the browser: it can only do what
# the row level security policies allow, which is why those policies matter.
# Supabase → Project Settings → API Keys → anon / public
#   (in newer projects this is called the "publishable" key and starts sb_publishable_)
# VERCEL: yes
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The admin key. It ignores every row level security policy, so it never goes
# into the browser and it is not needed in Vercel — it is used from your machine,
# by the import scripts, to write past the policies and put files in the bucket:
#
#   node scripts/import.mjs               the stories, photographs and quotes
#   node scripts/import-community.mjs     the community list and its portraits
#
# Supabase → Project Settings → API Keys → service_role  (reveal it first)
#   (in newer projects: the "secret" key, starting sb_secret_)
# VERCEL: no — keep this one local
#
# One exception worth knowing about. Inviting somebody from /admin → people goes
# through the public key like everything else, so it is the app that only offers
# it to admins, not the database: somebody holding the public key could still
# sign themselves up against Supabase directly. Closing that properly means
# turning signups off in Supabase → Authentication → Providers → Email AND
# putting this key in Vercel so the invitation can use the admin API instead.
# Until then, joining is closed in the app and open in the database.
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------ site ---

# Where the site lives. Used for the link in the sign-in email, for canonical
# addresses, the sitemap and the reference people copy from a story. Locally
# leave it as http://localhost:3000; in Vercel it is the live domain.
#
# Pick ONE of www and the bare domain and let Vercel redirect the other to it.
# Not a style question: the cookie that keeps somebody signed in belongs to the
# host that set it, so signing in on www and then walking to the bare domain
# would arrive signed out. One canonical host, one session.
#
# Left unset, Vercel's own project address is used — fine before a domain, wrong
# after one, because the sign-in link would send people to the .vercel.app copy.
# VERCEL: yes
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# When the new site opens. Until this moment, every address answers with the
# holding page and its clock; anybody signed in sees the site itself, which is
# how you check it before the doors open (the way in is three knocks on the
# mark, then /account/sign-in).
# Write the offset into the value, so it means the same instant everywhere:
# seven in the evening in Switzerland is 19:00:00+02:00 in summer, +01:00 in
# winter. Left unset it is the announced moment, 2026-08-20T19:00:00+02:00.
# To open the site now, put a moment in the past here — or the word "off",
# which is not a date and so counts as open.
# VERCEL: yes
NEXT_PUBLIC_LAUNCH_AT=off


# ------------------------------------------------------------------- mail ---

# The one email this site sends itself: the note that asks somebody to confirm
# their newsletter address. Everything to do with signing in goes through
# Supabase's own SMTP settings instead — this is a separate thing, because a
# newsletter address is not an account.
#
# The same Infomaniak mailbox the sign-in emails go through: the domain's mail
# already lives there and its SPF record already says so, so there is no second
# sender for a spam filter to be suspicious of.
#
# With these unset nothing is sent and the form says so rather than claiming an
# email is on its way. Nobody is ever written to who has not answered the
# confirmation — that is the whole point of the second step.
# VERCEL: yes, all four
SMTP_HOST=mail.infomaniak.com
# 465 is TLS from the first byte; 587 starts plain and upgrades.
SMTP_PORT=465
SMTP_USER=info@promenoodology.com
SMTP_PASS=
# Who it comes from, if not the mailbox above.
SMTP_FROM=


# --------------------------------------------------------------- reminders ---
#
# NEXT_PUBLIC_SUPABASE_URL above never changes when the site's domain does — it
# is the address of the database, not of the site. What does have to be told
# about a new domain is Supabase → Authentication → URL Configuration:
#
#   Site URL:        the one canonical host, e.g. https://promenoodology.com
#   Redirect URLs:   http://localhost:3000/**
#                    https://promenoodology.com/**
#                    https://www.promenoodology.com/**
#                    https://app.promenoodology.com/**
#                    https://promenoodology.vercel.app/**
#
# Both www and the bare domain belong on that list even though only one is
# canonical: the list is checked against the address the email link was asked
# for, and a host that is missing from it does not bounce loudly — the link
# quietly goes to the Site URL instead, which looks like the link working for
# whoever set it up and like the link being broken for everybody else.
#
# After changing anything in Vercel, redeploy — environment variables are read
# at build time, not at request time.

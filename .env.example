# promeNOODology — environment variables
#
# HOW TO USE
#   1. Copy this file:  cp .env.example .env.local
#   2. Fill in the values from the Supabase dashboard (where to find each one is
#      written above it).
#   3. Restart `npm run dev` — Next.js only reads this file at startup.
#
# .env.local is git-ignored and must stay that way: it holds a key that can read
# and write everything in the database.
#
# The right-hand column says whether the variable also belongs in Vercel:
#   Project → Settings → Environment Variables (tick Production, Preview and
#   Development for all three of the ones marked "yes").


# ---------------------------------------------------------------- Supabase ---

# The project's address.
# Supabase → Project Settings → Data API → Project URL
# VERCEL: yes
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# The public key. This one is meant to be in the browser: it can only do what
# the row level security policies allow, which is why those policies matter.
# Supabase → Project Settings → API Keys → anon / public
#   (in newer projects this is called the "publishable" key and starts sb_publishable_)
# VERCEL: yes
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The admin key. It ignores every row level security policy, so it never goes
# into the browser and it is not needed in Vercel — it is used once, from your
# machine, to create the tables and import the CSVs and text files.
# Supabase → Project Settings → API Keys → service_role  (reveal it first)
#   (in newer projects: the "secret" key, starting sb_secret_)
# VERCEL: no — keep this one local
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------ site ---

# Where the site lives. Used for the links in the members' magic-link emails and
# for canonical addresses. Locally leave it as http://localhost:3000; in Vercel
# set it to https://promenoodology.com.
# VERCEL: yes
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --------------------------------------------------------------- reminders ---
#
# In Supabase → Authentication → URL Configuration, add these redirect URLs, or
# the magic links will bounce:
#   http://localhost:3000/**
#   https://promenoodology.com/**
#   https://app.promenoodology.com/**
#
# After changing anything in Vercel, redeploy — environment variables are read
# at build time, not at request time.

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>promeNOOD</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>To take a photograph for your portrait, or for something you post.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>To choose a photograph for your portrait, or for something you post.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>To save a photograph from the archive to your own pictures.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!--
	  Portrait on an iPad too.
	
	  It used to allow every orientation on the grounds that an iPad is held
	  whichever way up somebody is holding it. What that actually gave was a
	  thousand-point-wide window holding a five-hundred-point column of app with
	  paper either side of it — the same app, further away. This is a phone app
	  that runs on an iPad, and saying so is better than pretending otherwise.
	
	  Upside down is out with it: a card, a tab bar and a keyboard have a right way
	  up, and nothing here is worth reading standing on its head.
	-->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!--
	  And no multitasking, which is the other half of the same sentence: an app
	  pinned to portrait in a Slide Over pane is an app in a shape it was never
	  drawn for.
	-->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!--
	  Long-press the app's icon: three things somebody actually opens the app to do.
	  Handled in AppDelegate, which tells the web view where to go.
	-->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>whats-on</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>What's on</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>The next evenings</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeDate</string>
			<key>UIApplicationShortcutItemUserInfo</key>
			<dict>
				<key>where</key>
				<string>/app/events</string>
			</dict>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>say-something</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Say something</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>To everybody</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeCompose</string>
			<key>UIApplicationShortcutItemUserInfo</key>
			<dict>
				<key>where</key>
				<string>/app/connect</string>
			</dict>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>your-card</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Your card</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Membership and number</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeContact</string>
			<key>UIApplicationShortcutItemUserInfo</key>
			<dict>
				<key>where</key>
				<string>/app/account</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>

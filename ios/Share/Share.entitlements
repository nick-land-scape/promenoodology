<?xml version="1.0" encoding="UTF-8"?>
<!--
  The one thing this extension needs: the container it shares with the app.
  It has no keys, no network and no session — it writes files and stops.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.promenoodology.community</string>
	</array>
</dict>
</plist>
